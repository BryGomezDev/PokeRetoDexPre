# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (contain local paths, not for public repos)
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# Firebase service account credentials – never commit these
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
scripts/*.json

# Script output – generated data, not for version control
scripts/out/
scripts/spike/out/
